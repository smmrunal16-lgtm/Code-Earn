# Copy to .env locally or configure these in your hosting provider.
NODE_ENV=production
APP_URL=https://your-domain.example
PORT=3000
SESSION_SECRET=replace-with-a-long-random-session-secret
TOKEN_ENCRYPTION_KEY=replace-with-a-long-random-secret-for-encrypting-oauth-tokens

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://your-domain.example/auth/google/callback

# Microsoft Entra admin center -> App registrations
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=https://your-domain.example/auth/microsoft/callback
